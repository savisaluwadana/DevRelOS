FROM golang:1.24-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/devrelos-api ./services/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/devrelos-api /usr/local/bin/devrelos-api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/devrelos-api"]
