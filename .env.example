# Core API / database
DEVRELOS_HTTP_ADDR=:8080
DATABASE_URL=postgres://devrelos:devrelos@localhost:5432/devrelos?sslmode=disable
NEXT_PUBLIC_API_URL=/api/devrelos
DEVRELOS_API_URL=http://localhost:8080
DEVRELOS_API_TOKEN=
DEVRELOS_REQUIRE_AUTH=false
DEVRELOS_DEFAULT_WORKSPACE=default
DEVRELOS_DEFAULT_PROJECT=default
DEVRELOS_CORS_ORIGIN=http://localhost:3000

# 32-byte master key used for AES-256-GCM connector-secret encryption.
# Generate for production with: openssl rand -base64 32
DEVRELOS_SECRET_KEY=

# Browser / operator access
DEVRELOS_WEB_USERNAME=
DEVRELOS_WEB_PASSWORD=
DEVRELOS_WEB_SESSIONS=false
DEVRELOS_SESSION_MAX_AGE_SECONDS=28800
DEVRELOS_SESSION_SECURE_COOKIE=false

# Request protection / observability
DEVRELOS_RATE_LIMIT_ENABLED=true
DEVRELOS_RATE_LIMIT_RPM=120
DEVRELOS_TRUST_PROXY=false

# Workers / media
DEVRELOS_WORKER_POLL_INTERVAL=5s
DEVRELOS_MEDIA_ROOT=./data/media
DEVRELOS_MEDIA_OUTPUT_ROOT=./data/media/outputs
DEVRELOS_FFMPEG_BIN=ffmpeg

# Approval-gated SMTP delivery. Keep disabled until configured.
DEVRELOS_SMTP_ENABLED=false
DEVRELOS_SMTP_HOST=
DEVRELOS_SMTP_PORT=587
DEVRELOS_SMTP_USERNAME=
DEVRELOS_SMTP_PASSWORD=
DEVRELOS_SMTP_FROM=
DEVRELOS_SMTP_FROM_NAME=DevRelOS
DEVRELOS_SMTP_STARTTLS=true
DEVRELOS_SMTP_REQUIRE_TLS=true
DEVRELOS_OUTREACH_MAX_ATTEMPTS=5

# Backwards-compatible provider environment credential.
# Prefer encrypted workspace secrets in Access & Security.
GITHUB_TOKEN=

# Production Compose / Caddy
DEVRELOS_DOMAIN=
POSTGRES_DB=devrelos
POSTGRES_USER=devrelos
POSTGRES_PASSWORD=
